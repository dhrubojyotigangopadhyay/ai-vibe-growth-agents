FILE: extract_events.py
import sys
from bs4 import BeautifulSoup
import re

def extract_event_urls():
    html = sys.stdin.read()
    soup = BeautifulSoup(html, "html.parser")

    links = soup.find_all("a", href=re.compile(r"event/"))
    urls = set()

    for link in links:
        href = link.get("href")
        if href:
            urls.add(f"https://events.linuxfoundation.org{href}")

    with open("event_urls.txt", "w") as f:
        for url in urls:
            f.write(url + "\n")

if __name__ == "__main__":
    extract_event_urls()

---

FILE: couchbase_utils.py
import asyncio
import os
from bs4 import BeautifulSoup
from crawl4ai import AsyncWebCrawler

async def extract_talk_info(html):
    soup = BeautifulSoup(html, "html.parser")

    return {
        "title": soup.title.string if soup.title else "Unknown",
        "description": soup.get_text()[:500],
    }

async def crawl():
    with open("event_urls.txt") as f:
        urls = [u.strip() for u in f.readlines()]

    async with AsyncWebCrawler() as crawler:
        for url in urls:
            result = await crawler.arun(url)
            if result and result.html:
                data = await extract_talk_info(result.html)
                print(data)

if __name__ == "__main__":
    asyncio.run(crawl())

---

FILE: embeddinggeneration.py
import os
from openai import OpenAI

client = OpenAI(
    base_url=os.getenv("NEBIUS_API_BASE"),
    api_key=os.getenv("NEBIUS_API_KEY")
)

def embed(text):
    res = client.embeddings.create(
        model="intfloat/e5-mistral-7b-instruct",
        input=text
    )
    return res.data[0].embedding

---

FILE: adk_research_agent.py
import os
from exa_py import Exa
from tavily import TavilyClient

def run_adk_research(topic):
    exa = Exa(api_key=os.getenv("EXA_API_KEY"))
    tavily = TavilyClient(api_key=os.getenv("TAVILY_API_KEY"))

    exa_results = exa.search_and_contents(topic, num_results=3)
    tavily_results = tavily.search(query=topic)

    return f"EXA: {exa_results}\nTAVILY: {tavily_results}"

---

FILE: talk_suggestions_app.py
import os
import streamlit as st
from openai import OpenAI
from adk_research_agent import run_adk_research

client = OpenAI(
    base_url=os.getenv("NEBIUS_API_BASE"),
    api_key=os.getenv("NEBIUS_API_KEY")
)

st.title("Conference Talk Generator")

query = st.text_area("Enter your idea")

if st.button("Generate"):
    research = run_adk_research(query)

    prompt = f"""
    Idea: {query}

    Research:
    {research}

    Generate a conference talk proposal.
    """

    res = client.chat.completions.create(
        model="Qwen/Qwen3-235B-A22B",
        messages=[{"role": "user", "content": prompt}]
    )

    st.write(res.choices[0].message.content)

---

EXECUTION:

streamlit run talk_suggestions_app.py

---

RUNTIME BEHAVIOR:

1. User enters idea in UI
2. ADK agents fetch real-time data
3. System retrieves context (simulated or DB)
4. Embeddings used for similarity
5. LLM (Nebius) generates final proposal
6. Output shown in Streamlit UI

